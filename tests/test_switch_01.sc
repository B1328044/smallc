
int main() {
    int day = 3;
    switch (day) {
        case 1:
            printf("Monday\n");
        case 2:
            printf("Tuesday\n");
        case 3:
            printf("Wednesday\n");
        case 4:
            printf("Thursday\n");
        default:
            printf("Other\n");
    }
    return 0;
}